# Konfigurasi Koneksi Database MySQL
# Untuk lokal (Laragon), nilai default sudah otomatis 127.0.0.1:3306 tanpa password.
# Untuk Vercel / Cloud, masukkan variabel berikut ke Dashboard Vercel > Settings > Environment Variables

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=db_portofolio
DB_SSL=false
